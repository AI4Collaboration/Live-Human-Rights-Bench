{
  "model": "qwen/qwen3-32b",
  "samples": 10,
  "base_url": "https://openrouter.ai/api/v1",
  "summary_protocol": "one-summary-per-judgment",
  "scoring": {
    "scale": [
      0,
      100
    ],
    "violation_above": 60,
    "no_violation_below": 40,
    "aggregation": "most-frequent-category; ties abstain"
  },
  "temperature": 1.0,
  "max_case_chars": 50000,
  "max_completion_tokens_initial": 8000,
  "prompt_version": "atomic-target-prompts-v1"
}
