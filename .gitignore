.DS_Store
.vscode
.env
.venv
__pycache__

# Output directories
other
results
figures
figures_new
data/experiments
logs
slurm/output

# Large data files
*.csv
!config/*.csv

# Keep only the main dataset
data/real_cases/
data/human_eval/
!data/datasets/

# HuggingFace cache
hf_cache/
.cache/

# The reviewed source proposal becomes the canonical dataset on publication.
# Keep evidence and the publication manifest, not a duplicate full corpus.
data/audits/leakage_20260915/proposed_sources.json
data/audits/leakage_20260915/PAUSE_REGENERATION

# Python cache
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info
dist
buildconfig.py
mlruns/

# annotation sheets carry judgment text and the control key
annotation/

# The human validation artefact is tracked on purpose: it is what the annotation
# figures in the paper are computed from. See docs/ANNOTATION.md.
!data/annotation/
!data/annotation/*.csv

# So is the brief the annotators worked from: the controls are scored against the
# rules it fixes, so it has to be readable rather than quoted from memory. It holds
# no judgment text and names nobody.
!docs/annotation/
!docs/annotation/*.md
